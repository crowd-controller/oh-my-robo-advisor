# tools 컨테이너 시크릿 — 정본: 계획 01 §1.6·§6.1
#
# 브로커·Telegram·SMTP 자격증명이 **없다**. import-linter 는 프로세스를 넘지
# 못하므로, app 의 .env 를 상속하면 `labs -/-> brokers` 계약이 프로세스 경계에서
# 무효화된다 — 같은 이미지·같은 키로 도는 별도 프로세스가 주문을 낼 수 있다.
#
# 기동 셀프체크 SC-13이 이 부재를 **강제**한다. 값이 들어 있으면 즉시 종료한다.
#
# 네트워크는 차단하지 않는다 — 리서치 수집기가 외부 소스를 읽어야 한다.
# 격리의 실체는 네트워크가 아니라 자격증명 부재다.

OMRA_TAG=dev

# 리서치 LLM (research 레이어 전용 — 주문 경로 무관)
ANTHROPIC_API_KEY=
