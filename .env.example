# app 컨테이너 시크릿 — 정본: 계획 01 §6.1
#
# 실파일은 `.env` 이며 **git 추적 대상이 아니고 chmod 600** 이다.
# 시크릿의 값은 여기 없고 발급일·만료일만 config/secrets_registry.yaml 에 있다.
#
# 규약: `Secrets` 는 고정 필드명(접두사 없음), `AppConfig` 오버라이드는
#       `OMRA__` 접두사만 읽는다 — 두 네임스페이스는 충돌하지 않는다.

# ── 배포 ──────────────────────────────────────────────────────────
OMRA_TAG=dev
OMRA_TAG_PREV=
OMRA_BIND_ADDR=127.0.0.1           # 실제 배포에서는 Tailscale 인터페이스 주소

# ── KIS 실전 ──────────────────────────────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# ── KIS 모의 (실전 키와 다른 경로 보관) ────────────────────────────
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=

# ── 업비트 (M7 착수 시점에 발급 — KIS와 6개월 이상 분산) ────────────
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ── 알림 이중화 (양쪽 모두 실패할 때만 집행 보류) ───────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ── 웹 대시보드 ───────────────────────────────────────────────────
WEB_SESSION_SECRET=
WEB_PASSWORD_HASH=

# ── dead-man's switch ─────────────────────────────────────────────
DMS_WEBHOOK_URL=
